{
  "name": "audiohub-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "hash-password": "tsx scripts/hash-password.ts",
    "test": "node --test --loader tsx test/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.0",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/static": "^8.0.0",
    "argon2": "^0.41.1",
    "better-sqlite3": "^11.3.0",
    "drizzle-orm": "^0.33.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "music-metadata": "^10.5.1",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.15",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
