# Copy this file to .env and fill in real values. Never commit the real .env file.

# Random long string used to sign/secure sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The single admin login for AudioHub.
ADMIN_USERNAME=

# Generate with: npm run hash-password -- 'your-password'   (run inside backend/)
# Paste ONLY the hash below — never the plaintext password.
# IMPORTANT: docker-compose interpolates $ in .env values, so double every '$' the hash
# script prints to '$$' (e.g. $argon2id$v=19$... -> $$argon2id$$v=19$$...) or the container
# will start with a mangled/empty password hash and login will fail.
ADMIN_PASSWORD_HASH=
